{
  "description": "Blocks direct file writes and edits inside the protected data folder.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect_data.py\""
          }
        ]
      }
    ]
  }
}
